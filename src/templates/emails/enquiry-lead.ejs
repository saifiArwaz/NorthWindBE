<!DOCTYPE html>
<html>

<head>
     <meta charset="UTF-8">
     <title>Email</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:Arial, sans-serif;">

     <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f4; padding:20px 0;">
          <tr>
               <td align="center">

                    <!-- Main Container -->
                    <table width="600" cellpadding="0" cellspacing="0" border="0"
                         style="background:#ffffff; border-radius:6px; overflow:hidden;">

                         <!-- Header -->
                         <tr>
                              <td align="center" style="background:#333; padding:20px;">
                                   <h2 style="color:#b98e42; margin:0;">
                                        New Lead: <span style="color:#ffffff;">
                                             <%= title %>
                                        </span>
                                   </h2>
                              </td>
                         </tr>

                         <!-- Body -->
                         <tr>
                              <td style="padding:25px; color:#333; font-size:14px; line-height:1.6;">

                                   <p style="margin:0 0 10px;">
                                        <strong>Hello Team,</strong>
                                   </p>

                                   <p style="margin:0 0 20px;">
                                        Someone has tried to contact your team. Here are the details:
                                   </p>

                                   <!-- Info Table -->
                                   <table width="100%" cellpadding="8" cellspacing="0" border="0"
                                        style="border-collapse:collapse;">
                                        
                                        <% let rowIndex = 0; %>
                                        <% for (const [key, value] of Object.entries(data)) { %>
                                             <% if (value !== undefined && value !== null && value !== '') { %>
                                                  <tr style="<%= rowIndex % 2 === 0 ? 'background:#f9f9f9;' : '' %>">
                                                       <td style="width: 40%; border-bottom: 1px solid #eee;"><strong><%= key %></strong></td>
                                                       <td style="border-bottom: 1px solid #eee;"><%= value %></td>
                                                  </tr>
                                                  <% rowIndex++; %>
                                             <% } %>
                                        <% } %>

                                   </table>

                                   <p style="margin-top:25px;">
                                        Cheers,<br>
                                        <strong>Radhey Group</strong>
                                   </p>

                              </td>
                         </tr>

                         <!-- Footer -->
                         <tr>
                              <td align="center" style="background:#f1f1f1; padding:15px; font-size:12px; color:#777;">
                                   © <%= new Date().getFullYear() %> Radhey Group. All rights reserved.
                              </td>
                         </tr>

                    </table>

               </td>
          </tr>
     </table>

</body>

</html>

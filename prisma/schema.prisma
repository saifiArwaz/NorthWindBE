generator client {
  provider = "prisma-client" // Required
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum FileType {
  image
  video
  link
}

enum TestimonialType {
  customer
  stakeholder
}

enum ProjectSectionTypes {
  overview
  gallery
  highlights
  amenities
  construction
  floorPlan
  locationadvantage
  tower
}

enum ProjectFloorPlanTypes {
  floorplan
  masterplan
}

enum ProjectGalleryTypes {
  exterior
  interior
  gallery
  construction
}

enum ProjectContentDetailsTypes {
  highlight
  specification
  amenities
}

enum MediaType {
  walkthrough
  lifestyle
  location
  construction
}

enum CityContentDetailTypes {
  ecosystem
  lifestyle
  land_value
  land_why_choose
}

enum CitySectionTypes {
  overview
  ecosystem
  lifestyle
  project
}

enum gallerieTypes {
  career_fun_culture
  csr
  highlight
  events
  testimonial
}

enum csrContentTypes {
  plantation
  education
  healthcare
  events
  environment
  community
}

enum PartnerType {
  partner
  loan
}

enum PressType {
  online
  offline
}

enum InvestorDocumentType {
  new_release
  annual
  quarterly
}

enum FaqTypes {
  faq
  nri
  about
  tax_benefit
  emi
  investor
}

enum ProjectAmenityTypes {
  icon
  image
}

model User {
  id                               String                     @id @default(cuid())
  email                            String                     @unique
  name                             String?
  password                         String
  role                             Role                       @default(USER)
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  RefreshToken                     RefreshToken[]
  createdPages                     Pages[]                    @relation("CreatedPage")
  updatedPages                     Pages[]                    @relation("UpdatedPage")
  CreatedHomeLoanAssistance        HomeLoanAssistance[]       @relation("CreatedHomeLoanAssistance")
  UpdatedHomeLoanAssistance        HomeLoanAssistance[]       @relation("UpdatedHomeLoanAssistance")
  CreatedPageSections              PageSections[]             @relation("CreatedPageSections")
  UpdatedPageSections              PageSections[]             @relation("UpdatedPageSections")
  CreatedTeam                      Team[]                     @relation("CreatedTeam")
  UpdatedTeam                      Team[]                     @relation("UpdatedTeam")
  CreatedTimeline                  Timeline[]                 @relation("CreatedTimeline")
  UpdatedTimeline                  Timeline[]                 @relation("UpdatedTimeline")
  CreatedPlatter                   Platter[]                  @relation("CreatedPlatter")
  UpdatedPlatter                   Platter[]                  @relation("UpdatedPlatter")
  CreatedCity                      City[]                     @relation("CreatedCity")
  UpdatedCity                      City[]                     @relation("UpdatedCity")
  CreatedTypology                  Typology[]                 @relation("CreatedTypology")
  UpdatedTypology                  Typology[]                 @relation("UpdatedTypology")
  CreatedSubTypology               SubTypology[]              @relation("CreatedSubTypology")
  UpdatedSubTypology               SubTypology[]              @relation("UpdatedSubTypology")
  CreatedMappingTypologies         TypologySubTypology[]      @relation("CreatedMappingTypologies")
  UpdatedMappingTypologies         TypologySubTypology[]      @relation("UpdatedMappingTypologies")
  CreatedProjects                  Projects[]                 @relation("CreatedProjects")
  UpdatedProjects                  Projects[]                 @relation("UpdatedProjects")
  CreatedProjectSection            ProjectSection[]           @relation("CreatedProjectSection")
  UpdatedProjectSection            ProjectSection[]           @relation("UpdatedProjectSection")
  CreatedProjectContentDetails     ProjectContentDetails[]    @relation("CreatedProjectContentDetails")
  UpdatedProjectContentDetails     ProjectContentDetails[]    @relation("UpdatedProjectContentDetails")
  CreatedProjectsBanner            ProjectBanner[]            @relation("CreatedProjectsBanner")
  UpdatedProjectsBanner            ProjectBanner[]            @relation("UpdatedProjectsBanner")
  CreatedProjectsFloorplan         ProjectFloorPlan[]         @relation("CreatedProjectsFloorplan")
  UpdatedProjectsFloorplan         ProjectFloorPlan[]         @relation("UpdatedProjectsFloorplan")
  CreatedProjectsLocationAdvantage ProjectLocationAdvantage[] @relation("CreatedProjectsLocationAdvantage")
  UpdatedProjectsLocationAdvantage ProjectLocationAdvantage[] @relation("UpdatedProjectsLocationAdvantage")
  CreatedProjectsGallery           ProjectGallery[]           @relation("CreatedProjectsGallery")
  UpdatedProjectsGallery           ProjectGallery[]           @relation("UpdatedProjectsGallery")
  CreatedAmenities                 Amenities[]                @relation("CreatedAmenities")
  UpdatedAmenities                 Amenities[]                @relation("UpdatedAmenities")
  CreatedProjectsAmenities         ProjectAmenities[]         @relation("CreatedProjectsAmenities")
  UpdatedProjectsAmenities         ProjectAmenities[]         @relation("UpdatedProjectsAmenities")
  CreatedProjectStatus             ProjectStatus[]            @relation("CreatedProjectStatus")
  UpdatedProjectStatus             ProjectStatus[]            @relation("UpdatedProjectStatus")
  CreatedcsrActivity               csrActivity[]              @relation("CreatedcsrActivity")
  UpdatedcsrActivity               csrActivity[]              @relation("UpdatedcsrActivity")
  CreatedBlogs                     Blogs[]                    @relation("CreatedBlogs")
  UpdatedBlogs                     Blogs[]                    @relation("UpdatedBlogs")
  CreatedJobs                      Jobs[]                     @relation("CreatedJobs")
  UpdatedJobs                      Jobs[]                     @relation("UpdatedJobs")
  CreatedCareerGallery             CareerGallery[]            @relation("CreatedCareerGallery")
  UpdatedCareerGallery             CareerGallery[]            @relation("UpdatedCareerGallery")
  CreatedTestimonials              Testimonials[]             @relation("CreatedTestimonials")
  UpdatedTestimonials              Testimonials[]             @relation("UpdatedTestimonials")
  CreatedOfficesLocation           OfficesLocation[]          @relation("CreatedOfficesLocation")
  UpdatedOfficesLocation           OfficesLocation[]          @relation("UpdatedOfficesLocation")
  CreatedsocialLinks               socialLinks[]              @relation("CreatedsocialLinks")
  UpdatedsocialLinks               socialLinks[]              @relation("UpdatedsocialLinks")
  CreatedNews                      News[]                     @relation("CreatedNews")
  UpdatedNews                      News[]                     @relation("UpdatedNews")
  CreatedMediaCoverage             MediaCoverage[]            @relation("CreatedMediaCoverage")
  UpdatedMediaCoverage             MediaCoverage[]            @relation("UpdatedMediaCoverage")
  CreatedMediaKit                  MediaKit[]                 @relation("CreatedMediaKit")
  UpdatedMediaKit                  MediaKit[]                 @relation("UpdatedMediaKit")
  CreatedAwards                    Awards[]                   @relation("CreatedAwards")
  UpdatedAwards                    Awards[]                   @relation("UpdatedAwards")
  CreatedInverstorTabs             InverstorTabs[]            @relation("CreatedInverstorTabs")
  UpdatedInverstorTabs             InverstorTabs[]            @relation("UpdatedInverstorTabs")
  CreatedInvestorDocuments         InvestorDocuments[]        @relation("CreatedInvestorDocuments")
  UpdatedInvestorDocuments         InvestorDocuments[]        @relation("UpdatedInvestorDocuments")
  CreatedInstagramReel             InstagramReel[]            @relation("CreatedInstagramReel")
  UpdatedInstagramReel             InstagramReel[]            @relation("UpdatedInstagramReel")
  CreatedHomeLoan                  HomeLoan[]                 @relation("CreatedHomeLoan")
  UpdatedHomeLoan                  HomeLoan[]                 @relation("UpdatedHomeLoan")
  CreatedValues                    Values[]                   @relation("CreatedValues")
  UpdatedValues                    Values[]                   @relation("UpdatedValues")
  CreatedCountries                 Country[]                  @relation("CreatedCountries")
  UpdatedCountries                 Country[]                  @relation("UpdatedCountries")
  CreatedCitySection               CitySections[]             @relation("CreatedCitySection")
  UpdatedCitySection               CitySections[]             @relation("UpdatedCitySection")
  CreatedCityEcosystemLifestyle    CityEcosystemLifestyle[]   @relation("CreatedCityEcosystemLifestyle")
  UpdatedCityEcosystemLifestyle    CityEcosystemLifestyle[]   @relation("UpdatedCityEcosystemLifestyle")
  CreatedProjectsFaq               ProjectFaq[]               @relation("CreatedProjectsFaq")
  UpdatedProjectsFaq               ProjectFaq[]               @relation("UpdatedProjectsFaq")
  CreatedGalleriesList             GalleriesList[]            @relation("CreatedGalleriesList")
  UpdatedGalleriesList             GalleriesList[]            @relation("UpdatedGalleriesList")
  CreatedcsrContentDetails         csrContentDetails[]        @relation("CreatedcsrContentDetails")
  UpdatedcsrContentDetails         csrContentDetails[]        @relation("UpdatedcsrContentDetails")
  CreatedBlogCategories            BlogCategories[]           @relation("CreatedBlogCategories")
  UpdatedBlogCategories            BlogCategories[]           @relation("UpdatedBlogCategories")
  CreatedProjectsMedia             ProjectMedia[]             @relation("CreatedProjectsMedia")
  UpdatedProjectsMedia             ProjectMedia[]             @relation("UpdatedProjectsMedia")
  CreatedEventGalleries            EventGalleries[]           @relation("CreatedEventGalleries")
  UpdatedEventGalleries            EventGalleries[]           @relation("UpdatedEventGalleries")
  CreatedEventCategories           EventCategory[]            @relation("CreatedEventCategory")
  UpdatedEventCategories           EventCategory[]            @relation("UpdatedEventCategory")
  CreatedEvents                    Event[]                    @relation("CreatedEvents")
  UpdatedEvents                    Event[]                    @relation("UpdatedEvents")
  CreatedConstructionGalleries     ConstructionGalleries[]    @relation("CreatedConstructionGalleries")
  UpdatedConstructionGalleries     ConstructionGalleries[]    @relation("UpdatedConstructionGalleries")
  CreatedFaqs                      Faqs[]                     @relation("CreatedFaqs")
  UpdatedFaqs                      Faqs[]                     @relation("UpdatedFaqs")
  CreatedNriWhy                    NriWhy[]                   @relation("CreatedNriWhy")
  UpdatedNriWhy                    NriWhy[]                   @relation("UpdatedNriWhy")
  CreatedStates                    State[]                    @relation("CreatedStates")
  UpdatedStates                    State[]                    @relation("UpdatedStates")
  CreatedBrands                    Brands[]                   @relation("CreatedBrands")
  UpdatedBrands                    Brands[]                   @relation("UpdatedBrands")
  CreatedContentByTypes            ContentByTypes[]           @relation("CreatedContentByTypes")
  UpdatedContentByTypes            ContentByTypes[]           @relation("UpdatedContentByTypes")
  CreatedcsrContentGalleries       csrContentGalleries[]      @relation("CreatedcsrContentGalleries")
  UpdatedcsrContentGalleries       csrContentGalleries[]      @relation("UpdatedcsrContentGalleries")
  CreatedProjectsRera              ProjectRera[]              @relation("CreatedProjectsRera")
  UpdatedProjectsRera              ProjectRera[]              @relation("UpdatedProjectsRera")
  CreatedBlogFaq                   BlogFaq[]                  @relation("CreatedBlogFaq")
  UpdatedBlogFaq                   BlogFaq[]                  @relation("UpdatedBlogFaq")
  createdPartner                   Partner[]                  @relation("Createdpartner")
  updatedPartner                   Partner[]                  @relation("Updatedpartner")
  CreatedProjectTower              ProjectTower[]             @relation("CreatedProjectTower")
  UpdatedProjectTower              ProjectTower[]             @relation("UpdatedProjectTower")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Pages {
  id          String         @id @default(cuid())
  pageName    String         @unique
  slug        String         @unique
  title       Json?
  description Json?
  files       Json?
  seoTags     Json?
  watermark   String?
  alt         String?
  link        String?        @db.Text
  type        String?        @default("image")
  status      Boolean        @default(true)
  parentId    String?
  parent      Pages?         @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Pages[]        @relation("PageHierarchy")
  seq         Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  creator     User?          @relation("CreatedPage", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?          @relation("UpdatedPage", fields: [updatedBy], references: [id])
  sections    PageSections[]
  menuItems   MenuItem[]
  isDeleted   Boolean        @default(false)
}

model PageSections {
  id          String   @id @default(cuid())
  pageSlug    String
  type        String   @unique
  title       Json
  description Json?
  files       Json?
  alt         String?
  watermark   String?
  link        String?  @db.Text
  list        Json?
  status      Boolean  @default(true)
  seq         Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedPageSections", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedPageSections", fields: [updatedBy], references: [id])
  page        Pages    @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  isDeleted   Boolean  @default(false)

  @@index([pageSlug, type])
}

model Values {
  id               String   @id @default(cuid())
  key              String
  title            String
  shortDescription String?
  files            Json?
  alt              String?
  watermark        String?
  status           Boolean  @default(true)
  seq              Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  creator          User?    @relation("CreatedValues", fields: [createdBy], references: [id])
  updatedBy        String?
  updatedUser      User?    @relation("UpdatedValues", fields: [updatedBy], references: [id])
  isDeleted        Boolean  @default(false)
}

model Team {
  id          String   @id @default(cuid())
  name        String
  designation String
  files       Json?
  description Json?
  alt         String?
  watermark   String?
  isFounder   Boolean  @default(false)
  status      Boolean  @default(true)
  seq         Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedTeam", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedTeam", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model Timeline {
  id          String   @id @default(cuid())
  title       String?
  year        String?
  files       Json?
  alt         String?
  watermark   String?
  description Json?
  seq         Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedTimeline", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedTimeline", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model ProjectStatus {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String
  status      Boolean    @default(true)
  projects    Projects[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  creator     User?      @relation("CreatedProjectStatus", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?      @relation("UpdatedProjectStatus", fields: [updatedBy], references: [id])
  isDeleted   Boolean    @default(false)
}

model Platter {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String
  title       Json?
  description Json?
  files       Json?
  alt         String?
  watermark   String?
  status      Boolean    @default(true)
  seoTags     Json?
  projects    Projects[]
  seq         Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  creator     User?      @relation("CreatedPlatter", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?      @relation("UpdatedPlatter", fields: [updatedBy], references: [id])
  isDeleted   Boolean    @default(false)
}

model Typology {
  id          String                @id @default(cuid())
  name        String                @unique
  slug        String                @unique
  status      Boolean               @default(true)
  mappings    TypologySubTypology[]
  projects    Projects[]
  createdBy   String?
  creator     User?                 @relation("CreatedTypology", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?                 @relation("UpdatedTypology", fields: [updatedBy], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  isDeleted   Boolean               @default(false)
}

model SubTypology {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String
  status               Boolean               @default(true)
  mappings             TypologySubTypology[]
  projectSubTypologies ProjectSubTypology[]
  createdBy            String?
  creator              User?                 @relation("CreatedSubTypology", fields: [createdBy], references: [id])
  updatedBy            String?
  updatedUser          User?                 @relation("UpdatedSubTypology", fields: [updatedBy], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isDeleted            Boolean               @default(false)
}

model TypologySubTypology {
  id            String      @id @default(cuid())
  typologyId    String
  subTypologyId String
  typology      Typology    @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  subTypology   SubTypology @relation(fields: [subTypologyId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?
  creator       User?       @relation("CreatedMappingTypologies", fields: [createdBy], references: [id])
  updatedBy     String?
  updatedUser   User?       @relation("UpdatedMappingTypologies", fields: [updatedBy], references: [id])
}

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String
  status      Boolean  @default(true)
  createdBy   String?
  creator     User?    @relation("CreatedCountries", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedCountries", fields: [updatedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  states      State[]
  isDeleted   Boolean  @default(false)
}

model State {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String
  status      Boolean  @default(true)
  createdBy   String?
  creator     User?    @relation("CreatedStates", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedStates", fields: [updatedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])
}

model City {
  id          String     @id @default(cuid())
  name        String
  slug        String
  seoTags     Json?
  status      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projects    Projects[]
  createdBy   String?
  creator     User?      @relation("CreatedCity", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?      @relation("UpdatedCity", fields: [updatedBy], references: [id])
  isDeleted   Boolean    @default(false)

  @@unique([name])
}

model CitySectionLists {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CitySections {
  id          String           @id @default(cuid())
  cityId      String
  sectionType CitySectionTypes
  title       Json
  description Json?
  files       Json?
  alt         String?
  list        Json?
  seq         Int              @default(1)
  status      Boolean          @default(true)
  createdBy   String?
  creator     User?            @relation("CreatedCitySection", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?            @relation("UpdatedCitySection", fields: [updatedBy], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDeleted   Boolean          @default(false)
}

model CityEcosystemLifestyle {
  id               String                 @id @default(cuid())
  type             CityContentDetailTypes
  heading          String
  shortDescription String?
  files            Json?
  alt              String?
  watermark        String?
  status           Boolean                @default(true)
  seq              Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        String?
  creator          User?                  @relation("CreatedCityEcosystemLifestyle", fields: [createdBy], references: [id])
  updatedBy        String?
  updatedUser      User?                  @relation("UpdatedCityEcosystemLifestyle", fields: [updatedBy], references: [id])
  isDeleted        Boolean                @default(false)
}

model Awards {
  id          String   @id @default(cuid())
  title       String
  description String?
  files       Json?
  alt         String?
  watermark   String?
  status      Boolean  @default(true) //true->active, false->Inactive
  seq         Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedAwards", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedAwards", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model GalleriesList {
  id          String        @id @default(cuid())
  fileType    FileType      @default(image)
  type        gallerieTypes
  files       Json?
  alt         String?
  watermark   String?
  seq         Int           @default(0)
  status      Boolean       @default(true)
  createdBy   String?
  creator     User?         @relation("CreatedGalleriesList", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?         @relation("UpdatedGalleriesList", fields: [updatedBy], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isDeleted   Boolean       @default(false)
}

model Jobs {
  id              String           @id @default(cuid())
  title           String
  jobType         String?
  location        Json?
  description     Json?
  seq             Int              @default(0)
  status          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  creator         User?            @relation("CreatedJobs", fields: [createdBy], references: [id])
  updatedBy       String?
  updatedUser     User?            @relation("UpdatedJobs", fields: [updatedBy], references: [id])
  isDeleted       Boolean          @default(false)
  jobApplications jobApplication[]
}

model csrContentDetails {
  id               String   @id @default(cuid())
  title            String
  files            Json?
  alt              String?
  watermark        String?
  shortDescription String?
  status           Boolean  @default(true)
  seq              Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  creator          User?    @relation("CreatedcsrContentDetails", fields: [createdBy], references: [id])
  updatedBy        String?
  updatedUser      User?    @relation("UpdatedcsrContentDetails", fields: [updatedBy], references: [id])
  isDeleted        Boolean  @default(false)
}

model csrContentGalleries {
  id          String          @id @default(cuid())
  type        csrContentTypes @default(plantation)
  fileType    FileType        @default(image)
  files       Json?
  alt         String?
  watermark   String?
  link        String?
  seq         Int             @default(0)
  status      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  creator     User?           @relation("CreatedcsrContentGalleries", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?           @relation("UpdatedcsrContentGalleries", fields: [updatedBy], references: [id])
  isDeleted   Boolean         @default(false)
}

model BlogCategories {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedBlogCategories", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedBlogCategories", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model Blogs {
  id          String    @id @default(cuid())
  title       String    @unique
  slug        String    @unique
  dateAt      DateTime?
  description Json
  files       Json?
  alt         String?
  watermark   String?
  seoTags     Json?
  tag         String?
  isLatest    Boolean   @default(false)
  isFeature   Boolean   @default(false)
  isHome      Boolean   @default(false)
  status      Boolean   @default(true)
  seq         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  blogFaqs    BlogFaq[]
  creator     User?     @relation("CreatedBlogs", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?     @relation("UpdatedBlogs", fields: [updatedBy], references: [id])
  isDeleted   Boolean   @default(false)
}

model socialLinks {
  id          String   @id @default(cuid())
  key         String
  socialLink  String
  status      Boolean  @default(true)
  seq         Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedsocialLinks", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedsocialLinks", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model News {
  id          String    @id @default(cuid())
  title       String
  newsLink    String?
  logo        String?
  alt         String?
  watermark   String?
  dateAt      DateTime?
  status      Boolean   @default(true)
  seq         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  creator     User?     @relation("CreatedNews", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?     @relation("UpdatedNews", fields: [updatedBy], references: [id])
  isDeleted   Boolean   @default(false)
}

model Locality {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cityId    String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Projects {
  id                       String                     @id @default(cuid())
  slug                     String                     @unique
  projectName              String                     @unique
  cityId                   String?
  platterId                String
  type                     FileType                   @default(image)
  shortDescription         String?
  typologyId               String
  projectStatusId          String
  location                 String?
  files                    Json?
  alt                      String?
  watermark                String?
  brochure                 String?
  seoTags                  Json?
  otherDetails             Json?
  isPage                   Boolean                    @default(false)
  isFeature                Boolean                    @default(false)
  isHome                   Boolean                    @default(false)
  status                   Boolean                    @default(true)
  seq                      Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  // mapping with other project sections one to many
  city                     City?                      @relation(fields: [cityId], references: [id])
  platter                  Platter                    @relation(fields: [platterId], references: [id])
  typology                 Typology                   @relation(fields: [typologyId], references: [id])
  projectStatus            ProjectStatus              @relation(fields: [projectStatusId], references: [id])
  projectSubTypology       ProjectSubTypology[]
  // project section realtion
  projectSection           ProjectSection[]
  projectBanner            ProjectBanner[]
  projectAmenities         ProjectAmenities[]
  projectFloorplan         ProjectFloorPlan[]
  projectLocationAdvantage ProjectLocationAdvantage[]
  projectGallery           ProjectGallery[]
  projectFaqs              ProjectFaq[]
  projectMedias            ProjectMedia[]
  projectContentDetails    ProjectContentDetails[]
  createdBy                String?
  creator                  User?                      @relation("CreatedProjects", fields: [createdBy], references: [id])
  updatedBy                String?
  updatedUser              User?                      @relation("UpdatedProjects", fields: [updatedBy], references: [id])
  constructionGalleries    ConstructionGalleries[]
  projectTowers            ProjectTower[]

  seoFooterLinks SeoFooterLink[]
  isDeleted      Boolean         @default(false)

  @@index([projectName, slug, cityId, typologyId])
}


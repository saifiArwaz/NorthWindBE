// new schemas by jatin

model Partner {
  id          String   @id @default(cuid())
  title       String?
  alt         String?
  files       Json?
  watermark   String?
  link        String?
  seq         Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("Createdpartner", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("Updatedpartner", fields: [updatedBy], references: [id])
}

model HomeLoanAssistance {
  id          String   @id @default(cuid())
  files       Json?
  title       String
  alt         String?
  watermark   String?
  seq         Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("CreatedHomeLoanAssistance", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?    @relation("UpdatedHomeLoanAssistance", fields: [updatedBy], references: [id])
  isDeleted   Boolean  @default(false)
}

model Event {
  id          String          @id @default(cuid())
  title       String
  status      Boolean         @default(true)
  seq         Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  creator     User?           @relation("CreatedEvents", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?           @relation("UpdatedEvents", fields: [updatedBy], references: [id])
  isDeleted   Boolean         @default(false)
  categories  EventCategory[]
}

model EventCategory {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  status      Boolean          @default(true)
  seq         Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  creator     User?            @relation("CreatedEventCategory", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedUser User?            @relation("UpdatedEventCategory", fields: [updatedBy], references: [id])
  isDeleted   Boolean          @default(false)
  events      EventGalleries[] @relation("EventGalleryCategory")
}
